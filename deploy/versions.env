# Версии выкатки hammurapi-core (FTR.HMR.INFRA-0002). Меняются только через PR:
# так выкатка любого тега воспроизводима.

# Тег публичного репозитория hammurapi с переиспользуемым workflow deploy-component.yml.
# После изменения выполните deploy/sync-ref.sh — он подставит её в release.yml
# (в uses: нельзя использовать выражения).
DEPLOY_WORKFLOW_REF=v0.2.0

# Версия чартов в oci://ghcr.io/greenongrey/charts — совпадает с тегом релиза
# hammurapi-infra (vX.Y.Z → X.Y.Z).
CHART_VERSION=0.2.0

# Агент Pi в образе core (@earendil-works/pi-coding-agent, FTR.HMR.CMN-0004 R2).
# Обновление — отдельным PR: контрактные тесты pkg/pirpc и расширения
# hammurapi-workspace запускаются против этой версии.
PI_VERSION=1.1.0
