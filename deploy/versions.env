# Versions of the rollout of hammurapi-core (FTR.HMR.INFRA-0002). They change only through a PR,
# so a rollout of any tag is reproducible.

# The tag of the public repository hammurapi with the reusable workflow deploy-component.yml.
# After a change, run deploy/sync-ref.sh: it puts the tag into release.yml
# (uses: takes no expressions).
DEPLOY_WORKFLOW_REF=v0.2.2

# The version of the charts in oci://ghcr.io/greenongrey/charts: it matches the release tag
# installer (vX.Y.Z → X.Y.Z).
CHART_VERSION=0.3.0

